# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# environment variables and secrets
.env*
!.env.example

# vercel
.vercel
.vercel-global
.npm-cache
.pnpm-store
/scripts/vercel-safe-host.cjs
/scripts/vercel-env-sync.mjs

# typescript
next-env.d.ts
*.tsbuildinfo

# local deployment and tool state
/.agents/
/.codex/
/outputs/
/work/

# legacy Sites/Vinext starter files kept locally for recovery
/.openai/*
!/.openai/hosting.json
/.sites-runtime/
/.vinext/
/.wrangler/
/build/
/components/
/db/
/dist/
/drizzle/
/examples/
/hooks/
/tests/
/vendor/
/worker/
/app/chatgpt-auth.ts
/lib/utils.ts
/cloudflare-env.d.ts
/components.json
/drizzle.config.ts
/vite.config.ts
/public/file.svg
/public/globe.svg
/public/window.svg
