# Paid API requests are disabled by default. Guest visitors always use offline rules.
# Only the owner can opt in for signed-in users by setting both values below.
# ECHOHIRE_ALLOW_PAID_API=true
# OPENAI_API_KEY=your-own-project-key

# Optional. EchoHire defaults to gpt-5.4-mini when this is omitted.
OPENAI_MODEL=gpt-5.4-mini
